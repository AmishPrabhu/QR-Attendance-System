{
  "version": 2,
  "builds": [
    {
      "src": "qr-server/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["qr-server/public/**", "qr-server/roster.csv"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "qr-server/server.js"
    }
  ]
}
